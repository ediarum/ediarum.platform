# Copy to .env. Compose reads it to fill in the ${VAR}s of compose.yaml. webdav's own variables
# go in env/webdav.env (template: ediarum.webdav's .env.example).

# webdav's compose.yaml, pinned to a release tag. For local testing, a path such as
# ../ediarum.webdav/compose.yaml works too.
WEBDAV_COMPOSE=https://github.com/ediarum/ediarum.WEBDAV.git#<tag>:compose.yaml

# Host port of the proxy.
PROXY_PORT=8080
PLATFORM_VERSION=dev
